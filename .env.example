# PostgreSQL
POSTGRES_DB=adw
POSTGRES_USER=adw
POSTGRES_PASSWORD=adw
POSTGRES_PORT=5432

# Backend
DB_URL=jdbc:postgresql://localhost:5432/adw
DB_USERNAME=adw
DB_PASSWORD=adw

# Encryption master key for secrets at rest (AES-256-GCM), external to the repo.
# Required in production. Generate with: openssl rand -base64 32
# The LLM provider/model/API key are configured in-app (Configuración) and stored
# encrypted in the database — never in this file.
APP_SECRET_ENCRYPTION_KEY=
