# PostgreSQL
POSTGRES_DB=adw
POSTGRES_USER=adw
POSTGRES_PASSWORD=adw
POSTGRES_PORT=5432

# Backend
DB_URL=jdbc:postgresql://localhost:5432/adw
DB_USERNAME=adw
DB_PASSWORD=adw

# LLM provider (Fase 2+). Never commit real keys.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=2048

# Encryption master key for secrets at rest (AES-GCM), external to the repo.
# Generate with: openssl rand -base64 32
APP_SECRET_ENCRYPTION_KEY=
